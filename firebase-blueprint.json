{
  "entities": {
    "studyNote": {
      "title": "StudyNote",
      "description": "A user's private research or clinical note attached to an embryonic developmental stage",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the note",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "The UID of the note author",
          "maxLength": 128
        },
        "stageId": {
          "type": "string",
          "description": "The embryo stage ID (e.g. day1-zygote, day5-blastocyst)",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Title of the clinical or study note",
          "minLength": 1,
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "description": "Body text of the embryonic study note",
          "minLength": 1,
          "maxLength": 3000
        },
        "tag": {
          "type": "string",
          "description": "Categorical tag such as Anatomy, Clinical, Exam, or Cell Biology",
          "maxLength": 40
        },
        "structureId": {
          "type": "string",
          "description": "Optional structure identifier related to the note",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "stageId", "title", "content", "createdAt", "updatedAt"]
    },
    "customPreset": {
      "title": "CustomPreset",
      "description": "Saved 3D viewport and slicing configuration for inspecting an embryo stage",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the preset",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "UID of the owner",
          "maxLength": 128
        },
        "stageId": {
          "type": "string",
          "description": "Target embryonic stage ID",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Name of the custom camera preset",
          "minLength": 1,
          "maxLength": 80
        },
        "sliceAxis": {
          "type": "string",
          "description": "Slicing axis",
          "enum": ["none", "x", "y", "z"]
        },
        "slicePosition": {
          "type": "number",
          "description": "Cut plane depth from -1.5 to 1.5"
        },
        "explodedView": {
          "type": "number",
          "description": "Layer separation amount 0 to 1.5"
        },
        "transparentOuterLayers": {
          "type": "boolean",
          "description": "Whether outer tissues have alpha transparency"
        },
        "showLabels": {
          "type": "boolean",
          "description": "Whether 3D pinned tags are shown"
        },
        "autoRotate": {
          "type": "boolean",
          "description": "Whether turntable rotation is enabled"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "stageId", "name", "sliceAxis", "slicePosition", "explodedView", "transparentOuterLayers", "showLabels", "autoRotate", "createdAt", "updatedAt"]
    },
    "stageProgress": {
      "title": "StageProgress",
      "description": "Student study mastery and quiz performance for a Carnegie stage",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stage ID identifier",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "UID of the user",
          "maxLength": 128
        },
        "stageId": {
          "type": "string",
          "description": "Embryo stage identifier",
          "maxLength": 64
        },
        "isMastered": {
          "type": "boolean",
          "description": "Whether student flagged this stage as fully understood"
        },
        "quizScore": {
          "type": "number",
          "description": "Best self-assessment score percentage (0-100)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "stageId", "isMastered", "quizScore", "updatedAt"]
    },
    "discussionPost": {
      "title": "DiscussionPost",
      "description": "A collaborative student question or clinical observation for an embryonic stage",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of discussion post",
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "description": "UID of author",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "description": "Display name of author",
          "minLength": 1,
          "maxLength": 80
        },
        "stageId": {
          "type": "string",
          "description": "Embryonic stage ID",
          "maxLength": 64
        },
        "structureName": {
          "type": "string",
          "description": "Optional structure tagged in question",
          "maxLength": 80
        },
        "content": {
          "type": "string",
          "description": "The discussion post question or comment",
          "minLength": 3,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "authorId", "authorName", "stageId", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/notes/{noteId}": {
      "schema": "studyNote",
      "description": "User private study notes on embryo stages"
    },
    "/users/{userId}/presets/{presetId}": {
      "schema": "customPreset",
      "description": "User custom 3D inspection camera presets"
    },
    "/users/{userId}/progress/{stageId}": {
      "schema": "stageProgress",
      "description": "User mastery progress and quiz score per stage"
    },
    "/discussions/{discussionId}": {
      "schema": "discussionPost",
      "description": "Public student and medical discussion notes per stage"
    }
  }
}
